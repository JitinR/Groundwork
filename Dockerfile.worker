# Legacy disabled Compose profile. Native execution now uses the separately
# staged Linux worker and executor; see docs/NATIVE-WORKER-DEPLOYMENT.md.
# This image deliberately contains no application, token, database or binaries.
FROM node:22-bookworm-slim
USER 65534:65534
ENV NATIVE_WORKER_ENABLED=false
CMD ["node", "-e", "console.error('This legacy worker image is disabled. Use the sealed Linux worker and executor documented in docs/NATIVE-WORKER-DEPLOYMENT.md.'); process.exit(78)"]
