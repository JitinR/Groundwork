# Dedicated sealed client only; no dotenv loader reads this automatically.
# Pass explicit values through the reviewed Linux launcher.
GROUNDWORK_WORKER_AUTHORITY_ORIGIN=https://secure-nexus-xi.vercel.app
GROUNDWORK_WORKER_ID=pilot-worker-01
GROUNDWORK_WORKER_KINDS=dxf-to-dwg,dwg-to-dxf,opensees-static
GROUNDWORK_WORKER_TOKEN_FILE=/credentials/token
GROUNDWORK_WORKER_EXECUTOR_SOCKET=/run/executor/executor.sock
# Token: at least 32 random bytes encoded as base64url, in a private regular
# file (0400 or 0600). Never reuse a database, user-session or provider token.
