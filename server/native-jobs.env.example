# Native adapter reference only. HTTP authorities reject enablement; a
# separate scoped worker service and per-job executor are not supplied here.
NATIVE_WORKER_ENABLED=false
NATIVE_LIBREDWG_VERSION=0.13.4
NATIVE_DWG2DXF_PATH=
NATIVE_DXF2DWG_PATH=
NATIVE_OPENSEES_VERSION=3.8.0
NATIVE_OPENSEES_PATH=
NATIVE_PRLIMIT_PATH=
NATIVE_SANDBOX_UID=
NATIVE_SANDBOX_GID=
# Keep false on web deployments. This flag does not create confinement.
NATIVE_ISOLATION_ACKNOWLEDGED=false
