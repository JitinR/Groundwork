# Authority configuration. These defaults keep every native job disabled.
# Read docs/NATIVE-WORKER-DEPLOYMENT.md before enabling a scoped pilot.
NATIVE_WORKER_ENABLED=false
NATIVE_REMOTE_WORKER_ENABLED=false
NATIVE_REMOTE_WORKERS_JSON=[]
# Registration shape (hash only; never put the raw worker token here):
# [{"id":"pilot-worker-01","tokenSha256":"<64 lower-case hex>","projectIds":["<project id>"],"kinds":["dxf-to-dwg"]}]

# Legacy direct-adapter reference only. Never enable it on an HTTP authority.
NATIVE_LIBREDWG_VERSION=0.13.4
NATIVE_DWG2DXF_PATH=
NATIVE_DXF2DWG_PATH=
NATIVE_OPENSEES_VERSION=3.8.0
NATIVE_OPENSEES_PATH=
NATIVE_PRLIMIT_PATH=
NATIVE_SANDBOX_UID=
NATIVE_SANDBOX_GID=
# Keep false on web deployments. This flag does not create confinement.
NATIVE_ISOLATION_ACKNOWLEDGED=false
